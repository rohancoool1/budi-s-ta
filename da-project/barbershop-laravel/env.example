APP_NAME="HOMCUTS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

ADMIN_NAME="HOMCUTS Admin"
ADMIN_EMAIL=admin@brassandblade.test
ADMIN_PASSWORD="ganti-password-admin-anda"

APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=barbershop
DB_USERNAME=barbershop
DB_PASSWORD=barbershop_secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=homcutsbarbershop@gmail.com
MAIL_PASSWORD="isi-app-password-google-anda"
MAIL_FROM_ADDRESS="homcutsbarbershop@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Aktivasi akun hanya membutuhkan OTP email, tanpa OTP telepon/SMS.
# Isi MAIL_PASSWORD di .env dengan App Password Google yang valid.
CUSTOMER_OTP_MAILER=smtp

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# File ini adalah template; aplikasi membaca .env.
# Untuk instalasi lama, pertahankan APP_KEY dan password yang berlaku di .env.
# DB_* mengikuti compose.yaml bawaan; sesuaikan jika database Anda berbeda.
